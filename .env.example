# Proposales
# Server-only. Never expose this value to browser code.
PROPOSALES_API_KEY=

# Proposales company used by this deployment.
# Server-only application configuration.
PROPOSALES_COMPANY_ID=

# Base origin used to construct human-facing proposal editor URLs.
PROPOSALES_EDITOR_ORIGIN=https://secure.proposales.com

# AI runtime configuration.
# Supported providers: openai | anthropic
AI_PROVIDER=openai

# Provider-specific model identifier.
AI_MODEL=gpt-5.6-luna

# Provider credentials.
# Only the key matching AI_PROVIDER is required at runtime.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=